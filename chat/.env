# Shared defaults. Put secrets and personal overrides in .env.local (git-ignored).

# "<provider>/<model>", e.g. openai/gpt-5.6-terra or anthropic/claude-sonnet-4-6
MODEL=openai/gpt-5.6-terra
# Azure OpenAI (v1 API). The Azure key goes in OPENAI_API_KEY in .env.local; MODEL must use the Azure deployment name.
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1

# COPILOTKIT_TELEMETRY_DISABLED=true

# The hotel API (../api/)
# HOTEL_API_URL=http://localhost:4112
